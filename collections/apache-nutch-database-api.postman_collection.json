        {
          "id": "1065ed17-25a9-4ccf-900c-0129b251dee9",
          "name": "Apache Nutch Get FetchDB Node Information",
          "request": {
            "name": "Apache Nutch Get FetchDB Node Information",
            "description": {
              "content": "Returns fetch node database entries for the specified index range. Both from and to default to 0; if to is 0 or exceeds the total number of entries, all entries from the starting index are returned.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "db",
                "fetchdb"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "from",
                  "value": "0",
                  "description": "Starting index (inclusive). Defaults to 0."
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "0",
                  "description": "Ending index (inclusive). Defaults to 0 (returns all)."
                }
              ],
              "variable": [
                {
                  "description": "The protocol used to access the Nutch server. (This can only be one of http,https)",
                  "type": "any",
                  "value": "{{protocol}}",
                  "key": "protocol"
                },
                {
                  "description": "The port the Nutch server listens on. Configurable via the --port command-line argument.",
                  "type": "any",
                  "value": "{{port}}",
                  "key": "port"
                }
              ]
            },
            "header": [
