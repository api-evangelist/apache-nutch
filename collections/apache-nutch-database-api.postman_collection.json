          "name": "Apache Nutch Query the CrawlDB",
          "request": {
            "name": "Apache Nutch Query the CrawlDB",
            "description": {
              "content": "Executes a query against the Nutch CrawlDB. The type field in the request body determines the operation: stats, dump, topN, or url. The stats and url types return JSON; dump and topN return binary octet-stream data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "db",
                "crawldb"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The protocol used to access the Nutch server. (This can only be one of http,https)",
                  "type": "any",
                  "value": "{{protocol}}",
                  "key": "protocol"
                },
                {
                  "description": "The port the Nutch server listens on. Configurable via the --port command-line argument.",
                  "type": "any",
                  "value": "{{port}}",
                  "key": "port"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"crawlId\": \"<string>\",\n  \"type\": \"<string>\",\n  \"confId\": \"<string>\",\n  \"args\": {\n    \"key_0\": \"<string>\"\n  }\n}",
