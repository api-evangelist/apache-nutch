          "name": "Apache Nutch Get Server Status",
          "request": {
            "name": "Apache Nutch Get Server Status",
            "description": {
              "content": "Returns the current status of the Nutch server including start date, known configurations, all jobs, and currently running jobs.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "admin",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The protocol used to access the Nutch server. (This can only be one of http,https)",
                  "type": "any",
                  "value": "{{protocol}}",
                  "key": "protocol"
                },
                {
                  "description": "The port the Nutch server listens on. Configurable via the --port command-line argument.",
                  "type": "any",
                  "value": "{{port}}",
                  "key": "port"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
