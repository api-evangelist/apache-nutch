        {
          "id": "93d9f73a-832e-43af-a7a1-9e61a2adb730",
          "name": "Apache Nutch Stop the Nutch Server",
          "request": {
            "name": "Apache Nutch Stop the Nutch Server",
            "description": {
              "content": "Initiates a graceful shutdown of the Nutch server. If jobs are still running and force is not set, the server will refuse to stop.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "admin",
                "stop"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "force",
                  "value": "false",
                  "description": "If true, kills any running jobs before stopping the server."
                }
              ],
              "variable": [
                {
                  "description": "The protocol used to access the Nutch server. (This can only be one of http,https)",
                  "type": "any",
                  "value": "{{protocol}}",
                  "key": "protocol"
                },
                {
                  "description": "The port the Nutch server listens on. Configurable via the --port command-line argument.",
                  "type": "any",
                  "value": "{{port}}",
                  "key": "port"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "f76ba93b-9a73-41f2-a10d-c49a87b6f915",
