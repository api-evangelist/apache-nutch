        {
          "name": "fetchdb",
          "item": [
            {
              "name": "Apache Nutch Get FetchDB Node Information",
              "id": "f30fe302-5dd2-4edd-9016-7d78ab29b327",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/db/fetchdb?from=0&to=0",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "db",
                    "fetchdb"
                  ],
                  "query": [
                    {
                      "description": "Starting index (inclusive). Defaults to 0.",
                      "key": "from",
                      "value": "0"
                    },
                    {
                      "description": "Ending index (inclusive). Defaults to 0 (returns all).",
                      "key": "to",
                      "value": "0"
                    }
                  ]
                },
                "description": "Returns fetch node database entries for the specified index range. Both from and to default to 0; if to is 0 or exceeds the total number of entries, all entries from the starting index are returned."
              },
              "response": [
                {
                  "id": "66bcbdd7-6584-4b10-bd97-5253d67a8a3c",
                  "name": "A JSON array of fetch node information objects.",
                  "originalRequest": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/json"
                      },
                      {
                        "description": "Added as a part of security scheme: basic",
                        "key": "Authorization",
                        "value": "Basic <credentials>"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/db/fetchdb?from=0&to=0",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "db",
                        "fetchdb"
                      ],
                      "query": [
                        {
                          "description": "Starting index (inclusive). Defaults to 0.",
                          "key": "from",
                          "value": "0"
                        },
                        {
                          "description": "Ending index (inclusive). Defaults to 0 (returns all).",
                          "key": "to",
                          "value": "0"
                        }
                      ]
                    }
                  },
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [
                    {
                      "key": "Content-Type",
                      "value": "application/json"
                    }
                  ],
                  "cookie": [],
                  "responseTime": null,
                  "body": "[\n  {\n    \"children\": [\n      {\n        \"childUrl\": \"<string>\",\n        \"anchorText\": \"<string>\"\n      },\n      {\n        \"childUrl\": \"<string>\",\n        \"anchorText\": \"<string>\"\n      }\n    ],\n    \"url\": \"<string>\",\n    \"status\": \"<integer>\",\n    \"numOfOutlinks\": \"<integer>\"\n  },\n  {\n    \"children\": [\n      {\n        \"childUrl\": \"<string>\",\n        \"anchorText\": \"<string>\"\n      },\n      {\n        \"childUrl\": \"<string>\",\n        \"anchorText\": \"<string>\"\n      }\n    ],\n    \"url\": \"<string>\",\n    \"status\": \"<integer>\",\n    \"numOfOutlinks\": \"<integer>\"\n  }\n]",
